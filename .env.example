# All optional — the app runs fully without any of these set; email sending
# just stays a safe no-op (see shared/ses.js) until SES setup is complete.
# See README.md's "Email setup" section for the manual AWS steps this needs.

# The "From" address for outgoing email — must be a verified SES identity
# (a verified domain, or a verified single email address).
SES_FROM_EMAIL=

# A real postal address, required by CAN-SPAM in every email's footer.
SES_MAILING_ADDRESS=

# Any long random string — signs unsubscribe links. Generate with e.g.
# `openssl rand -hex 32`. Changing this invalidates every unsubscribe link
# already sent, so treat it like a real secret, not something to rotate casually.
UNSUBSCRIBE_SECRET=

# The deployed frontend's base URL (no trailing slash), used to build links
# back to a trip inside emails. e.g. https://trip-planner-manifest.web.app
APP_BASE_URL=

# This stack's own deployed HTTP API base URL (no trailing slash) — the
# unsubscribe link's actual target. Grab this from the CloudFormation stack
# output (HttpApiUrl) after the first deploy, then set it here and redeploy.
API_BASE_URL=
